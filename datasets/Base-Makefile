ptn-directify:
	rsync -r --delete "`pwd`"/* "`pwd`".directed
	make -C "`pwd`".directed _directify-ptn
	@echo
	@echo Directification finished! The directified network can be found in
	@echo
	@echo "`pwd`".directed
	@echo

