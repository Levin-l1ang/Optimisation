setting-name; setting-value
include; "../../Global-Config.cnf"
# ===========================================================================
# === LOCAL_ONLY from Global-Config.cnf =====================================
# ===========================================================================
ptn_name; "grid-multimodal"
period_length; 60
time_units_per_minute; 1
ptn_draw_conversion_factor; 1
loads_draw_conversion_factor; 1
od_draw_conversion_factor; 1
sl_radius; 0
gen_conversion_length; 1
gen_conversion_coordinates; 0.02
ean_default_minimal_waiting_time; 0
ean_default_maximal_waiting_time; 3
ean_default_minimal_change_time; 3
ean_default_maximal_change_time; 62
# ===========================================================================
# === Network Specific Settings =============================================
# ===========================================================================
odptn_missing_values; "GLOBAL_MEAN_VALUE"
lpool_evaluate_average_traveling_time_lower_bound; true
# ===========================================================================
# === Multimodal Settings ===================================================
# ===========================================================================
modalities_all; [tram, bus, bike]
fixed_timetable_modalities; []
tram.modality_category; "line-based"
bus.modality_category; "line-based"
bike.modality_category; "nonscheduled"
tram.gen_passengers_per_vehicle; 50
bus.gen_passengers_per_vehicle; 60
bike.gen_passengers_per_vehicle; 2
ean_intermodal_change_penalty; 5
tram.load_generator_fixed_upper_frequency; 40
bus.load_generator_fixed_upper_frequency; 50
bike.load_generator_fixed_upper_frequency; 1000
# speed of the vehicles in km/h
tram.gen_vehicle_speed; 20
bus.gen_vehicle_speed; 50
bike.gen_vehicle_speed; 15
# ===========================================================================
# === Optimized Visualization  ==============================================
# ===========================================================================
# the scale of the plotted image
lpool_opt_visualisation_plot_scale; 1
lpool_opt_visualisation_plot_margins; 0.3
lpool_opt_visualisation_line_distance; 1
lpool_opt_visualisation_line_width; 5
lpool_opt_visualisation_draw_legend; true
# the scale of the legend in plotted image
lpool_opt_visualisation_legend_scaling; 0.8
# location of legend (best, upper/center/lower right/center/left)
lpool_opt_visualisation_legend_location; center right
# size for nodes when scaling is off
lpool_opt_visualisation_def_node_size; 900
lpool_opt_visualisation_node_labels; true
# font size of node labels
lpool_opt_visualisation_node_label_size; 10
#multimodal
lpool_opt_visualisation_same_color_modality; true
# ===========================================================================
# === State / Experiments / Automatization ==================================
# ===========================================================================
include_if_exists; "State-Config.cnf"
include_if_exists; "Private-Config.cnf"
include_if_exists; "After-Config.cnf"